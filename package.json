{
  "name": "@llz-real/mcp-tool-lint",
  "version": "0.1.0",
  "description": "Lint MCP tool schemas and descriptions for LLM-callability, then measure the gap with an A/B benchmark.",
  "type": "module",
  "license": "MIT",
  "author": "李林臻 (https://github.com/LLZ-real)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLZ-real/mcp-tool-lint.git"
  },
  "homepage": "https://github.com/LLZ-real/mcp-tool-lint#readme",
  "bugs": {
    "url": "https://github.com/LLZ-real/mcp-tool-lint/issues"
  },
  "bin": {
    "mcp-tool-lint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types test/all.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "bench": "node --experimental-strip-types benchmark/run.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "agents",
    "tool-calling",
    "linter"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
